# AquaHope Foundation Environment Configuration Template
VITE_APP_NAME="AquaHope Foundation"
VITE_APP_URL="https://aquahope.org"
VITE_API_BASE_URL="https://api.aquahope.org/v1"

# Payment Gateways (Pesapal Sandbox & Production)
VITE_PESAPAL_CONSUMER_KEY="dummy_pesapal_consumer_key_sandbox"
VITE_PESAPAL_CONSUMER_SECRET="dummy_pesapal_consumer_secret_sandbox"
VITE_PESAPAL_ENV="sandbox"
VITE_PESAPAL_NOTIFICATION_ID="dummy_ipn_notification_id_001"

# Default Currencies & Tax Info
VITE_DEFAULT_CURRENCY="USD"
VITE_SUPPORTED_CURRENCIES="USD,KES,EUR,GBP,CAD,AUD"
VITE_CHARITY_TAX_ID="EIN-83-9281742"
VITE_UK_GIFT_AID_RATE="0.25"
VITE_TRANSACTION_FEE_PERCENTAGE="0.029"
VITE_TRANSACTION_FEE_FIXED="0.30"

# Feature Flags
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_HONEYPOT_SECURITY="true"
VITE_ENABLE_RECEIPT_DOWNLOADS="true"
